// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
      "ctrl-<": "vim::GoToPreviousTab",
      "ctrl->": "vim::GoToTab",
    },
  },
  {
    "context": "vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::NormalBefore",
      "j j": "vim::NormalBefore",
      "jj": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // only in normal mode
      "space r": "editor::Rename",
      // "space l f": "editor::Format",
      "space a": "tab_switcher::Toggle",
      "space space": "file_finder::Toggle",
      "space g s": "search::SelectAllMatches",
      "space o": "outline::Toggle",
      "space v": "editor::GoToDefinitionSplit",
      "space s f": "pane::DeploySearch",
      "space t": "workspace::NewCenterTerminal",
      "n": "search::SelectNextMatch",
      "shift-n": "search::SelectPreviousMatch",
      "space /": "workspace::NewSearch",
      "+ +": "workspace::Save",
      "space ;": "buffer_search::Deploy",
      // "space g": "git::Blame",
      "space l s": "buffer_search::Deploy",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual || Terminal",
    "bindings": {
      "alt-m z": "workspace::ToggleZoom"
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      // only in visual mode
    },
  },
  {
    "context": "Editor && (vim_mode == visual || vim_mode == normal) && !VimWaiting && !menu",
    "bindings": {
      // in normal and visual mode
      "shift-k": "editor::Hover",
      ";": "command_palette::Toggle",
      "/ /": "editor::ToggleComments",
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "g r": "editor::FindAllReferences",
    },
  },
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "alt-m v": "pane::SplitVertical",
      "alt-m s": "pane::SplitHorizontal",

      "ctrl-w": "pane::CloseActiveItem",
    },
  },
  {
    "context": "(vim_mode == normal || Dock) && !Terminal",
    "bindings": {
      "space e": "workspace::ToggleLeftDock",
      "space r": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "vim_operator == d",
    "unbind": {
      "s": "vim::PushDeleteSurrounds"
    }
  },
  {
    "context": "vim_operator == c",
    "unbind": {
      "s": [
        "vim::PushChangeSurrounds",
        {}
      ]
    }
  },
  {
    "context": "vim_operator == helix_m",
    "unbind": {
      "s": "vim::PushHelixSurroundAdd"
    }
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "s": "vim::Substitute"
    }
  },
  {
    "context": "vim_mode == helix_select",
    "unbind": {
      "s": "vim::Substitute"
    }
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "unbind": {
      "s": "vim::Substitute"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "unbind": {
      "s": "workspace::OpenWithSystem"
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_next || vim_operator == helix_previous",
    "unbind": {
      "s": "vim::Sentence"
    }
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs || vim_operator == helix_previous || vim_operator == helix_next",
    "bindings": {
      "s": "vim::Sentence"
    }
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu && menu",
    "bindings": {
      "s": "vim::HelixSelectRegex"
    }
  }
]
